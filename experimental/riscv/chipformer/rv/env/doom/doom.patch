+
+static void R_HashTextures (void)
+{
+    int i;
+
+    texturenext = Z_Malloc (numtextures * sizeof(*texturenext), PU_STATIC, 0);
+    for (i = 0; i < TEXTUREHASH; i++)
+        texturehash[i] = -1;
+    for (i = numtextures - 1; i >= 0; i--)
+    {
+        unsigned h = R_HashTextureName (textures[i]->name);
+        texturenext[i] = texturehash[h];
+        texturehash[h] = i;
+    }
+}
