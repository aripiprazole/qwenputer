+#define TEXTUREHASH 512
+static short texturehash[TEXTUREHASH];
+static short* texturenext;
+
+static unsigned R_HashTextureName (const char* name)
+{
+    unsigned h = 0;
+    int i;
+
+    for (i = 0; i < 8 && name[i]; i++)
+        h = h * 31 + toupper (name[i]);
+    return (h * 0x9E3779B1u) >> 23;
