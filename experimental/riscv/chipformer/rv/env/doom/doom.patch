+// Qwenputer: a hash of the (upper-case) lump names, built once all files are added. Each
+// chain lists its lumps from the last one added, so the first match is the one the backward
+// scan found ("patch lump files take precedence").
+#define LUMPHASH 2048
+static short lumphash[LUMPHASH];
+static short* lumpnext;
+
+static unsigned W_HashName (int v1, int v2)
+{
+    return ((unsigned)v1 * 0x9E3779B1u ^ (unsigned)v2 * 0x85EBCA6Bu) >> 21;
+}
+
+static void W_BuildHash (void)
+{
+    int i;
+
+    lumpnext = malloc (numlumps * sizeof(*lumpnext));
+    for (i = 0; i < LUMPHASH; i++)
+        lumphash[i] = -1;
+    for (i = 0; i < numlumps; i++)
+    {
+        unsigned h = W_HashName (*(int *)lumpinfo[i].name, *(int *)&lumpinfo[i].name[4]);
+        lumpnext[i] = lumphash[h];
+        lumphash[h] = i;
+    }
+}
